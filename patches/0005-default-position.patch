index 0000000..a7464ac
--- /dev/null
+++ b/src/components/start_position.ts
@@ -0,0 +1,76 @@
+import {Coordinates} from "./coordinates";
+
+// Homelab: the default map view (used only without stored state and without URL
+// parameters) can be set by an optional config.json next to index.html:
+//   {"center": {"lat": <number>, "lon": <number>}, "zoom": <integer>}
+// A missing, unreadable or invalid file falls back to the upstream default.
+
+export interface StartPosition {
+    center: Coordinates;
+    zoom: number;
+}
+
+export const DEFAULT_START_POSITION: StartPosition = {
+    center: new Coordinates(48, 8),
+    zoom: 13,
+};
+
+export const START_POSITION_URL = "config.json";
+export const START_POSITION_TIMEOUT_MS = 2000;
+const MIN_ZOOM = 0;
+const MAX_ZOOM = 20;
+
+const is_object = (value: unknown): value is Record<string, unknown> =>
+    typeof value === "object" && value !== null && !Array.isArray(value);
+
+const is_number_in = (value: unknown, min: number, max: number): value is number =>
+    typeof value === "number" && Number.isFinite(value) && value >= min && value <= max;
+
+export const parse_start_position = (data: unknown): StartPosition | null => {
+    if (!is_object(data) || !is_object(data.center)) {
+        return null;
+    }
+    const {lat, lon} = data.center;
+    const {zoom} = data;
+    if (
+        !is_number_in(lat, -90, 90) ||
+        !is_number_in(lon, -180, 180) ||
+        !is_number_in(zoom, MIN_ZOOM, MAX_ZOOM) ||
+        !Number.isInteger(zoom)
+    ) {
+        return null;
+    }
+
+    return {center: new Coordinates(lat, lon), zoom};
+};
+
+export const load_start_position = async (
+    timeout_ms: number = START_POSITION_TIMEOUT_MS,
+): Promise<StartPosition> => {
+    const controller = new AbortController();
+    const timer = setTimeout((): void => controller.abort(), timeout_ms);
+    try {
+        const response = await fetch(START_POSITION_URL, {
+            cache: "no-store",
+            signal: controller.signal,
+        });
+        if (response.status === 404) {
+            return DEFAULT_START_POSITION;
+        }
+        if (!response.ok) {
+            throw new Error(`status=${response.status}`);
+        }
+        const start_position = parse_start_position(await response.json());
+        if (start_position === null) {
+            throw new Error("invalid content");
+        }
+
+        return start_position;
+    } catch (error) {
+        console.warn(`Ignoring ${START_POSITION_URL}, using the default start position:`, error);
+
+        return DEFAULT_START_POSITION;
+    } finally {
+        clearTimeout(timer);
+    }
+};
