diff --git a/tests/start_position.test.ts b/tests/start_position.test.ts
new file mode 100644
index 0000000..fa2afed
--- /dev/null
+++ b/tests/start_position.test.ts
@@ -0,0 +1,171 @@
+import {afterEach, beforeEach, describe, expect, test, vi} from "vitest";
+
+import type {App} from "../src/components/app";
+import {Coordinates} from "../src/components/coordinates";
+import {MapState} from "../src/components/map_state";
+import {
+    DEFAULT_START_POSITION,
+    load_start_position,
+    parse_start_position,
+    START_POSITION_URL,
+} from "../src/components/start_position";
+
+const valid = {center: {lat: 50.0, lon: 10.0}, zoom: 9};
+
+describe("parse_start_position", () => {
+    test("accepts a valid configuration", () => {
+        const position = parse_start_position(valid);
+        expect(position?.center.equals(new Coordinates(50.0, 10.0))).toBe(true);
+        expect(position?.zoom).toBe(9);
+    });
+
+    test.each([
+        [{center: {lat: -90, lon: -180}, zoom: 0}],
+        [{center: {lat: 90, lon: 180}, zoom: 20}],
+    ])("accepts the limits %j", (data) => {
+        expect(parse_start_position(data)).not.toBeNull();
+    });
+
+    test.each([
+        ["null", null],
+        ["an array", [valid]],
+        ["a string", "50.0,10.0"],
+        ["no center", {zoom: 9}],
+        ["no zoom", {center: {lat: 50.0, lon: 10.0}}],
+        ["center as array", {center: [50.0, 10.0], zoom: 9}],
+        ["lat as string", {center: {lat: "50.0", lon: 10.0}, zoom: 9}],
+        ["lon missing", {center: {lat: 50.0}, zoom: 9}],
+        ["lat > 90", {center: {lat: 90.1, lon: 10.0}, zoom: 9}],
+        ["lat < -90", {center: {lat: -90.1, lon: 10.0}, zoom: 9}],
+        ["lon > 180", {center: {lat: 50.0, lon: 180.1}, zoom: 9}],
+        ["lon < -180", {center: {lat: 50.0, lon: -180.1}, zoom: 9}],
+        ["lat NaN", {center: {lat: NaN, lon: 10.0}, zoom: 9}],
+        ["zoom not an integer", {center: {lat: 50.0, lon: 10.0}, zoom: 9.5}],
+        ["zoom < 0", {center: {lat: 50.0, lon: 10.0}, zoom: -1}],
+        ["zoom > 20", {center: {lat: 50.0, lon: 10.0}, zoom: 21}],
+        ["zoom as string", {center: {lat: 50.0, lon: 10.0}, zoom: "9"}],
+    ])("rejects %s", (_name, data) => {
+        expect(parse_start_position(data)).toBeNull();
+    });
+});
+
+describe("load_start_position", () => {
+    afterEach(() => {
+        vi.unstubAllGlobals();
+        vi.restoreAllMocks();
+        vi.useRealTimers();
+    });
+
+    const stub_fetch = (response: () => Promise<Response>) => {
+        const fetch = vi.fn<typeof globalThis.fetch>(() => response());
+        vi.stubGlobal("fetch", fetch);
+
+        return fetch;
+    };
+
+    const json_response =
+        (body: string, status = 200): (() => Promise<Response>) =>
+        () =>
+            Promise.resolve(
+                new Response(body, {status, headers: {"Content-Type": "application/json"}}),
+            );
+
+    test("fetches config.json from the same origin without cache", async () => {
+        const fetch = stub_fetch(json_response(JSON.stringify(valid)));
+        const position = await load_start_position();
+        expect(fetch).toHaveBeenCalledOnce();
+        expect(fetch.mock.calls[0][0]).toBe(START_POSITION_URL);
+        expect(START_POSITION_URL).toBe("config.json");
+        expect(fetch.mock.calls[0][1]).toMatchObject({cache: "no-store"});
+        expect(position.center.equals(new Coordinates(50.0, 10.0))).toBe(true);
+        expect(position.zoom).toBe(9);
+    });
+
+    test("falls back silently on 404", async () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+        stub_fetch(json_response("not found", 404));
+        expect(await load_start_position()).toBe(DEFAULT_START_POSITION);
+        expect(warn).not.toHaveBeenCalled();
+    });
+
+    test.each([
+        ["broken JSON", json_response("{kaputt")],
+        ["invalid values", json_response(JSON.stringify({center: {lat: 91, lon: 10}, zoom: 9}))],
+        ["server error", json_response(JSON.stringify(valid), 500)],
+        ["network error", () => Promise.reject(new TypeError("Failed to fetch"))],
+    ])("falls back with a warning on %s", async (_name, response) => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+        stub_fetch(response);
+        expect(await load_start_position()).toBe(DEFAULT_START_POSITION);
+        expect(warn).toHaveBeenCalledOnce();
+    });
+
+    test("falls back after the timeout", async () => {
+        vi.useFakeTimers();
+        vi.spyOn(console, "warn").mockImplementation(() => undefined);
+        vi.stubGlobal(
+            "fetch",
+            vi.fn<typeof globalThis.fetch>(
+                (_url, init) =>
+                    new Promise<Response>((_resolve, reject) => {
+                        init?.signal?.addEventListener("abort", () =>
+                            reject(new DOMException("aborted", "AbortError")),
+                        );
+                    }),
+            ),
+        );
+        const result = load_start_position(2000);
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(await result).toBe(DEFAULT_START_POSITION);
+    });
+});
+
+describe("MapState.restore with a start position", () => {
+    let values: Map<string, string>;
+
+    beforeEach(() => {
+        values = new Map();
+        vi.stubGlobal("window", {
+            localStorage: {
+                getItem: (key: string): string | null => values.get(key) ?? null,
+                setItem: (key: string, value: string): void => {
+                    values.set(key, value);
+                },
+                removeItem: (key: string): void => {
+                    values.delete(key);
+                },
+            },
+        });
+    });
+
+    afterEach(() => {
+        vi.unstubAllGlobals();
+    });
+
+    const restore = (start_position?: Parameters<MapState["restore"]>[0]): MapState => {
+        const state = new MapState({translate: (key: string): string => key} as unknown as App);
+        state.restore(start_position);
+
+        return state;
+    };
+
+    test("uses the upstream default without a start position", () => {
+        const state = restore();
+        expect(state.center?.equals(new Coordinates(48, 8))).toBe(true);
+        expect(state.zoom).toBe(13);
+    });
+
+    test("uses the start position without stored state", () => {
+        const state = restore({center: new Coordinates(50.0, 10.0), zoom: 9});
+        expect(state.center?.equals(new Coordinates(50.0, 10.0))).toBe(true);
+        expect(state.zoom).toBe(9);
+    });
+
+    test("stored state wins over the start position", () => {
+        values.set("center", "47.5;9");
+        values.set("zoom", "12");
+        const state = restore({center: new Coordinates(50.0, 10.0), zoom: 9});
+        expect(state.center?.equals(new Coordinates(47.5, 9))).toBe(true);
+        expect(state.zoom).toBe(12);
+    });
+});
