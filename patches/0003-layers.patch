diff --git a/tests/map_type.test.ts b/tests/map_type.test.ts
new file mode 100644
index 0000000..7f47f91
--- /dev/null
+++ b/tests/map_type.test.ts
@@ -0,0 +1,24 @@
+import {describe, expect, test} from "vitest";
+
+import {MapType, string2maptype} from "../src/components/map_type";
+
+describe("string2maptype in the homelab build", () => {
+    test.each(["OPENSTREETMAP", "openstreetmap"])("keeps OpenStreetMap (%s)", (value) => {
+        expect(string2maptype(value)).toBe(MapType.OPENSTREETMAP);
+    });
+
+    test("keeps OpenTopoMap", () => {
+        expect(string2maptype("OPENTOPOMAP")).toBe(MapType.OPENTOPOMAP);
+    });
+
+    test.each(["STAMEN_TERRAIN", "HUMANITARIAN", "ARCGIS_WORLDIMAGERY", "ARCGIS_WORLDIMAGERY_OVERLAY"])(
+        "maps the removed base layer %s to OpenStreetMap",
+        (value) => {
+            expect(string2maptype(value)).toBe(MapType.OPENSTREETMAP);
+        },
+    );
+
+    test("still rejects unknown values", () => {
+        expect(string2maptype("UNKNOWN")).toBeNull();
+    });
+});
